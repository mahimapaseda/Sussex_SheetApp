{
  "name": "sheetapp",
  "version": "1.3.6",
  "description": "SheetApp - Compliant Google Sheets & WhatsApp Batch Automation Platform",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "electron": "electron .",
    "test": "node test/test-batch-engine.js && node test/test-server.js",
    "build": "electron-builder --win --publish=never"
  },
  "build": {
    "electronVersion": "34.2.0",
    "appId": "lk.sussex.sheetapp",
    "productName": "SheetApp",
    "copyright": "Copyright (c) 2026 Mahima Paseda | mahimapaseda.lk",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "data/settings.json",
      "data/sent_log.json",
      "data/assets/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "protocols": {
        "name": "SheetApp Protocol",
        "schemes": [
          "sheetapp"
        ]
      },
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SheetApp",
      "installerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable-${arch}.${ext}"
    }
  },
  "keywords": [
    "whatsapp",
    "google-sheets",
    "batch-automation",
    "anti-ban",
    "rate-limiting",
    "sheetapp"
  ],
  "author": "Mahima Paseda | mahimapaseda.lk",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "open": "^10.1.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^3.4.19"
  }
}
