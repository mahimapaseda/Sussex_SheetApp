{
  "$schema": "https://tokens.studio/schema.json",
  "name": "SheetApp Design System",
  "version": "1.0.0",
  "primitive": {
    "color": {
      "slate": {
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A",
        "950": "#020617"
      },
      "brand": {
        "50": "#ECFDF5",
        "100": "#D1FAE5",
        "200": "#A7F3D0",
        "300": "#6EE7B7",
        "400": "#34D399",
        "500": "#10B981",
        "600": "#059669",
        "700": "#047857",
        "800": "#065F46",
        "900": "#064E3B"
      },
      "whatsapp": {
        "light": "#25D366",
        "dark": "#128C7E",
        "deep": "#075E54"
      },
      "amber": {
        "50": "#FFFBEB",
        "100": "#FEF3C7",
        "400": "#FBBF24",
        "500": "#F59E0B",
        "600": "#D97706",
        "700": "#B45309"
      },
      "rose": {
        "50": "#FFF1F2",
        "100": "#FFE4E6",
        "400": "#FB7185",
        "500": "#F43F5E",
        "600": "#E11D48",
        "700": "#BE123C"
      },
      "blue": {
        "50": "#EFF6FF",
        "100": "#DBEAFE",
        "400": "#60A5FA",
        "500": "#3B82F6",
        "600": "#2563EB",
        "700": "#1D4ED8"
      }
    },
    "space": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "none": "0px",
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "full": "9999px"
    },
    "fontFamily": {
      "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "shadow": {
      "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)"
    }
  },
  "semantic": {
    "surface": {
      "canvas": "{primitive.color.slate.50}",
      "panel": "#FFFFFF",
      "panel-secondary": "{primitive.color.slate.100}",
      "modal-overlay": "rgba(15, 23, 42, 0.65)"
    },
    "text": {
      "primary": "{primitive.color.slate.900}",
      "secondary": "{primitive.color.slate.600}",
      "muted": "{primitive.color.slate.400}",
      "inverse": "#FFFFFF"
    },
    "brand": {
      "primary": "{primitive.color.whatsapp.dark}",
      "primary-hover": "{primitive.color.whatsapp.deep}",
      "accent": "{primitive.color.whatsapp.light}"
    },
    "border": {
      "subtle": "{primitive.color.slate.200}",
      "strong": "{primitive.color.slate.300}",
      "focus": "{primitive.color.whatsapp.dark}"
    },
    "compliance": {
      "safe-bg": "{primitive.color.brand.50}",
      "safe-text": "{primitive.color.brand.700}",
      "safe-border": "{primitive.color.brand.300}",
      "pacing-bg": "{primitive.color.blue.50}",
      "pacing-text": "{primitive.color.blue.700}",
      "cooldown-bg": "{primitive.color.amber.50}",
      "cooldown-text": "{primitive.color.amber.700}",
      "cooldown-border": "{primitive.color.amber.400}",
      "risk-bg": "{primitive.color.rose.50}",
      "risk-text": "{primitive.color.rose.700}",
      "risk-border": "{primitive.color.rose.400}"
    }
  },
  "component": {
    "button": {
      "height": "{primitive.space.10}",
      "padding-x": "{primitive.space.4}",
      "radius": "{primitive.radius.md}",
      "font-weight": "600",
      "font-size": "{primitive.fontSize.sm}"
    },
    "qr-card": {
      "size": "280px",
      "padding": "{primitive.space.6}",
      "radius": "{primitive.radius.lg}",
      "border": "{semantic.border.subtle}"
    },
    "progress-bar": {
      "height": "{primitive.space.2}",
      "radius": "{primitive.radius.full}",
      "track": "{primitive.color.slate.200}",
      "fill": "{primitive.color.whatsapp.dark}"
    },
    "badge": {
      "padding-x": "{primitive.space.2}",
      "padding-y": "{primitive.space.1}",
      "radius": "{primitive.radius.full}",
      "font-size": "{primitive.fontSize.xs}"
    }
  }
}
